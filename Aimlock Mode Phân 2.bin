[{"enabled":true,"name":"Support_Pain","url":["*/GetToken/*","*/AuthToken/*","*/CheckHackBehavior","*/GetConfig/*","*.garena.com/patch/*"],"script":"var url = request.url;\nvar headers = request.headers;\n// Đã loại bỏ dòng lỗi var \"  \"\nvar elapsed = context[\"startTime\"] ? Date.now() - context[\"startTime\"] : 0;\nconsole.log(\"[FF] \" + context[\"url\"] + \" | \" + elapsed + \"ms | \" + response.statusCode);\n\nif (response.headers[\"Authorization\"]) {\n  var raw = response.headers[\"Authorization\"].replace(\"Bearer \", \"\");\n  console.log(\"[FF] Token: \" + raw.substring(0, 10) + \"...\");\n}\n\nif (response.headers[\"X-Session-Token\"]) {\n  console.log(\"[FF] Session saved\");\n}\n\nif (response.headers[\"Set-Cookie\"]) {\n  var m = response.headers[\"Set-Cookie\"].match(/session=([^;]+)/);\n  if (m) console.log(\"[FF] Cookie session saved\");\n}\n\nresponse.headers[\"Cache-Control\"] = \"public, max-age=3600\";\nresponse.headers[\"X-Content-Type-Options\"] = \"nosniff\";\nresponse.headers[\"X-Frame-Options\"] = \"DENY\";\nresponse.headers[\"Strict-Transport-Security\"] = \"max-age=31536000; includeSubDomains\";\n\nif (response.body && typeof response.body === \"string\") {\n  var blockList = [\n    \"googlesyndication.com\",\"doubleclick.net\",\"adservice.google.com\",\n    \"pagead2.googlesyndication.com\",\"amazon-adsystem.com\",\n    \"facebook.com/tr\",\"connect.facebook.net\",\"analytics.google.com\",\n    \"googletagmanager.com\",\"appsflyer.com\",\"appsflyersdk.com\",\n    \"app-measurement.com\",\"crashlytics.com\",\n    \"firebaselogging-pa.googleapis.com\",\n    \"config.uca.cloud.unity3d.com\"\n  ];\n  blockList.forEach(function(d) {\n    response.body = response.body.split(d).join(\"blocked.invalid\");\n  });\n\n  var coreLogic = `\nclass AimEngine {\n  constructor() {\n    this.sensitivity = 1.35;\n    this.smoothing = 0.82;\n    this.stabilize = 0.65;\n    this.prediction = 0.25;\n    this.last = { x: 0, y: 0 };\n    this.velocity = { x: 0, y: 0 };\n  }\n  reset(x, y) {\n    this.last = { x, y };\n    this.velocity = { x: 0, y: 0 };\n  }\n  update(x, y) {\n    let dx = x - this.last.x;\n    let dy = y - this.last.y;\n    dx *= this.sensitivity;\n    dy *= this.sensitivity;\n    this.velocity.x = this.velocity.x * this.stabilize + dx * (1 - this.stabilize);\n    this.velocity.y = this.velocity.y * this.stabilize + dy * (1 - this.stabilize);\n    const px = this.velocity.x * this.prediction;\n    const py = this.velocity.y * this.prediction;\n    const sx = this.last.x + (dx + px) * this.smoothing;\n    const sy = this.last.y + (dy + py) * this.smoothing;\n    this.last.x = sx;\n    this.last.y = sy;\n    return { x: sx, y: sy };\n  }\n}\nclass AntiShake {\n  constructor() {\n    this.threshold = 0.4;\n    this.prevDx = 0;\n    this.prevDy = 0;\n  }\n  filter(dx, dy) {\n    if (Math.abs(dx) < this.threshold) dx = 0;\n    if (Math.abs(dy) < this.threshold) dy = 0;\n    return { dx, dy };\n  }\n}\nconst aim = new AimEngine();\nconst shake = new AntiShake();\ndocument.addEventListener(\"touchstart\", function(e) {\n  const t = e.touches[0];\n  aim.reset(t.clientX, t.clientY);\n}, { passive: true });\ndocument.addEventListener(\"touchmove\", function(e) {\n  const t = e.touches[0];\n  let dx = t.clientX - aim.last.x;\n  let dy = t.clientY - aim.last.y;\n  const f = shake.filter(dx, dy);\n  const r = aim.update(aim.last.x + f.dx, aim.last.y + f.dy);\n}, { passive: true });\ndocument.addEventListener(\"touchend\", function() {\n  aim.reset(aim.last.x, aim.last.y);\n}, { passive: true });\n`;\n  response.body = response.body + \"<script>\" + coreLogic + \"</script>\";\n}\n\nreturn response;"}]
